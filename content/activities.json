    {
      "id": "tamil-071",
      "text": "நான் கைகளைக் கழுவுகிறேன்.",
      "meaning": "I am washing my hands."
    },
    {
      "id": "tamil-072",
      "text": "நான் சிரிக்கிறேன்.",
      "meaning": "I am smiling."
