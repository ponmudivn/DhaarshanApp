    {"id":"read-003","sentence":"The wind is strong today.\nA blue kite flies high in the sky.\nMia holds the string tight.","answer":"🪁🔵☁️","choices":["🎈🔴☁️","🪁🔵☁️","🚗🔵🛣️"]},
    {"id":"read-004","sentence":"Mum picks a book for Sam.\nShe reads him a story.\nSam puts the book beside his bed.","answer":"📘🛏️","choices":["🍎🪑","📘🛏️","⚽🚪"]},
    {"id":"read-005","sentence":"A little frog sits on a log.\nIt sees a fly.\nThe frog jumps into the pond.","answer":"🐸🪵","choices":["🐸🪵","🐦🌳","🐠🪨"]},
    {"id":"read-006","sentence":"Sam takes his red ball to the park.\nHe kicks it to his friend.\nThey play together.","answer":"👦🏻🔴⚽","choices":["👦🏻🔴⚽","👧🏻🟡🪁","🐶🟢🥎"]},
