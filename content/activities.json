    {"id":"read-008","sentence":"A tiny bee lands on a pink flower.\nIt gathers nectar.\nThen it buzzes away.","answer":"🐝🌸","choices":["🦋🌻","🐝🌸","🐞🍃"]},
    {"id":"read-009","sentence":"Lee finds two red apples.\nLee puts them in a bag.\nThe apples are for lunch.","answer":"🍎🍎🛍️","choices":["🍐🛍️","🍎🍎🛍️","🍌🍌🎒"]},
    {"id":"read-010","sentence":"A sheep is sleepy.\nIt rests by the farm gate.\nSoon it closes its eyes.","answer":"🐑🚪","choices":["🐄🏠","🐑🚪","🐔🌾"]},
    {"id":"read-011","sentence":"Nina plants a seed in a pot.\nShe gives it water each day.\nA green leaf peeks out.","answer":"🪴💧","choices":["🪴💧","🧸🎀","🚲🛞"]},
    {"id":"read-012","sentence":"A tiny turtle walks to the pond.\nIt sees a lily pad.\nThe turtle rests in the shade.","answer":"🐢🪷","choices":["🐢🪷","🐱🧶","🐘🎈"]},
    {"id":"read-013","sentence":"Raj finds a shell on the beach.\nHe listens to the waves.\nHe puts the shell in his bucket.","answer":"🐚🏖️","choices":["🍂🌳","🐚🏖️","📚🏫"]},
    {"id":"read-014","sentence":"A brown puppy runs to the gate.\nIt wags its tail.\nMaya gives it a pat.","answer":"🐶🚪","choices":["🐶🚪","🐰🥕","🐟🫧"]},
    {"id":"read-015","sentence":"The moon shines above the house.\nA little owl sits in a tree.\nIt hoots softly.","answer":"🦉🌙","choices":["🐓☀️","🦉🌙","🦋🌼"]},
    {"id":"read-016","sentence":"Omar packs a sandwich for lunch.\nHe adds an apple to his bag.\nThen he walks to school.","answer":"🥪🍎🎒","choices":["🥪🍎🎒","🍦🏖️🩴","🥣🛏️🌙"]},
    {"id":"read-017","sentence":"Lily sees a rainbow after the rain.\nShe counts its bright colours.\nShe draws it in her book.","answer":"🌈📘","choices":["🌈📘","🌧️🚗","🎂🎁"]},
    {"id":"read-018","sentence":"A red fire truck races down the road.\nThe helpers reach a small house.\nThey put out the fire safely.","answer":"🚒🏠","choices":["🚒🏠","🚜🌾","🚢🌊"]},
    {"id":"read-019","sentence":"Noah finds a shiny pebble.\nHe puts it beside a blue one.\nThey make a little path.","answer":"🪨🪨","choices":["🪨🪨","🥚🧺","🍪🥛"]},
